# Example only. Restrict this file to postgres and source secrets from the host secret store.

[kori]
pg1-path=/var/lib/postgresql/17/main
pg2-host=kori-db-standby.internal
pg2-path=/var/lib/postgresql/17/main

[global]
repo1-type=s3
repo1-s3-bucket=kori-db-backups-prod
repo1-s3-endpoint=objects.internal
repo1-s3-region=garage
repo1-s3-uri-style=path
repo1-s3-key=<backup-access-key-from-secret-store>
repo1-s3-key-secret=<backup-secret-key-from-secret-store>
repo1-path=/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=<48-byte-random-passphrase-from-secret-store>
repo1-retention-full=4
repo1-retention-diff=14
repo1-bundle=y
repo1-block=y
compress-type=zst
process-max=4
start-fast=y
archive-async=y
spool-path=/var/spool/pgbackrest
backup-standby=y

[global:archive-push]
compress-level=3
