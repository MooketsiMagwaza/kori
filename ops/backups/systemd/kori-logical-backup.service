[Unit]
Description=Kori verified PostgreSQL logical backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kori-backup
Group=kori-backup
EnvironmentFile=/etc/kori/backup.env
ExecStart=/opt/kori/ops/backups/logical-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/kori
UMask=0077

[Install]
WantedBy=multi-user.target
