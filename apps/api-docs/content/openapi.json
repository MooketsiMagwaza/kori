{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PublicSightingRead": {
        "description": "What anyone else may see: an area, a quarter-hour time, no point, no observer.",
        "properties": {
          "area": {
            "$ref": "#/components/schemas/AreaRead"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "seen_at": {
            "format": "date-time",
            "title": "Seen At",
            "type": "string"
          },
          "sensitive": {
            "title": "Sensitive",
            "type": "boolean"
          },
          "species": {
            "title": "Species",
            "type": "string"
          }
        },
        "required": [
          "id",
          "species",
          "count",
          "seen_at",
          "area",
          "sensitive"
        ],
        "title": "PublicSightingRead",
        "type": "object"
      },
      "SpeciesRead": {
        "properties": {
          "area_m": {
            "title": "Area M",
