# Editors and operating systems
.DS_Store
Thumbs.db
*.iml
/.idea/
/.vscode/

# Secrets and local environment. Only the committed examples are allowed.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Node and Next.js build output
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/

# MapLibre worker copied from node_modules at build time
apps/*/public/maplibre/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local evidence and captures that are not meant for the repository
/scratch/
*.log

# Recovery drill evidence and release records stay local; copy them into the launch record.
/ops/backups/evidence/*.json
/deploy/records/
/deploy/.current-version

# Park packs and everything downloaded to build them are never committed: a real park is covered
# publicly only after DWNP agrees (KO-09, KO-14). Packs are built outside the repository
# (tools/map-pack); these rules catch one copied in by mistake.
*.pmtiles
*.mbtiles
*.npy
/packs/
/packs-local/
/tools/map-pack/out/
/tools/map-pack/downloads/
apps/*/public/packs/
apps/*/public/packs-local/
